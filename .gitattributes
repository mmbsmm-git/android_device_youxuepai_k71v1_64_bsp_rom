# 统一行尾：文本 LF，二进制不转换（Linux 构建）
* text=auto
*.mk        text eol=lf
*.sh        text eol=lf
*.py        text eol=lf
*.prop      text eol=lf
*.rc        text eol=lf
*.fstab     text eol=lf
*.xml       text eol=lf
*.txt       text eol=lf
*.bp        text eol=lf
*.md        text eol=lf
prebuilt/kernel          binary
prebuilt/*.img           binary
*.so                     binary
*.jar                    binary
*.apk                    binary
